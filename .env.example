# GitHub の fine-grained PAT（読み取り専用・対象リポジトリのみ）。
# このファイルをコピーして .env を作る。.env はコミットしない。
GITHUB_TOKEN=

# HTTP サーバー。ホスト上で直接動かす場合はこのままでよい。
# HOST=127.0.0.1
# PORT=3000

# SQLite ファイルのパス。docker compose では /data/four-keys.sqlite（volume）になる。
# DATABASE_PATH=./data/four-keys.sqlite

# 収集スケジュール（既定は毎時 0 分）と、起動時の追いつきの有無。
# COLLECT_CRON=0 * * * *
# COLLECT_ON_STARTUP=true
